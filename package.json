{
  "name": "agenttreasury",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "migrate": "node dist/src/migrate.js",
    "seed": "node dist/src/seed.js",
    "start": "node dist/src/server.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "worker": "node dist/src/worker.js",
    "settle": "node dist/src/settle.js",
    "reconcile": "node dist/src/reconcile.js",
    "reconcile:gateway": "node dist/src/reconcile-gateway.js",
    "refund": "node dist/src/refund.js",
    "merchant": "node dist/src/merchant-server.js",
    "research": "node dist/src/research.js",
    "preflight": "node dist/src/preflight.js",
    "verify:purchase": "node dist/src/verify-purchase.js",
    "wallets:init": "node scripts/init-wallets.mjs",
    "refund:send": "node dist/src/refund-send.js",
    "finance:local": "npm run build && node --env-file-if-exists=.env scripts/finance-local.mjs",
    "finance:demo": "npm run build && node scripts/finance-demo.mjs",
    "worker:refund": "node dist/src/finance-refund-worker.js"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "viem": "^2.57.19"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^18.6.0-beta.19",
    "typescript": "^5.9.3"
  }
}
