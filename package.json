{
  "name": "agenttreasury",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "migrate": "node dist/src/migrate.js",
    "seed": "node dist/src/seed.js",
    "start": "node dist/src/server.js",
    "test": "npm run build && node --test --test-concurrency=1 dist/test/*.test.js",
    "worker": "node dist/src/worker.js",
    "settle": "node dist/src/settle.js",
    "reconcile": "node dist/src/reconcile.js",
    "funding:record": "node dist/src/record-funding.js",
    "reconcile:gateway": "node dist/src/reconcile-gateway.js",
    "reconcile:gateway-balances": "node dist/src/reconcile-gateway-balances.js",
    "capture:gateway-balances": "node dist/src/capture-gateway-balance-sample.js",
    "replay:gateway-balances": "node dist/src/gateway-balance-evidence.js",
    "scan:gateway-balances": "node dist/src/gateway-balance-scanner.js",
    "eval:gateway": "node dist/src/evaluate-gateway-triage.js",
    "eval:gateway-evidence": "node dist/src/evaluate-gateway-evidence.js",
    "eval:gateway-investigation": "node dist/src/evaluate-gateway-investigation.js",
    "eval:gateway-patterns": "node dist/src/evaluate-gateway-patterns.js",
    "study:gateway": "npm run --silent build && node dist/src/study-gateway-triage.js",
    "worker:gateway": "node dist/src/settle-gateway.js",
    "merchant:gateway": "node dist/src/gateway-merchant-server.js",
    "buy:gateway": "node dist/src/buy-gateway-trace.js",
    "gateway:local": "npm run --silent build && node --env-file-if-exists=.env scripts/gateway-local.mjs",
    "gateway:wallet": "npm run --silent build && node --env-file-if-exists=.env scripts/gateway-wallet.mjs",
    "demo:offline": "npm run --silent build && node scripts/gateway-offline.mjs",
    "drill:investigation": "npm run --silent build && node scripts/investigation-recovery-drill.mjs",
    "refund": "node dist/src/refund.js",
    "merchant": "node dist/src/merchant-server.js",
    "research": "node dist/src/research.js",
    "preflight": "node dist/src/preflight.js",
    "verify:purchase": "node dist/src/verify-purchase.js",
    "verify:gateway": "node dist/src/verify-gateway-purchase.js",
    "wallets:init": "node scripts/init-wallets.mjs",
    "refund:send": "node dist/src/refund-send.js",
    "gateway:refund": "node dist/src/gateway-refund-send.js",
    "finance:local": "npm run build && node --env-file-if-exists=.env scripts/finance-local.mjs",
    "finance:demo": "npm run build && node scripts/finance-demo.mjs",
    "worker:refund": "node dist/src/finance-refund-worker.js",
    "worker:gateway-balances": "node dist/src/scan-gateway-balances.js",
    "test:operations": "npm run build && node --test --test-concurrency=1 dist/test/gateway-operations.test.js dist/test/gateway-balance-scan.test.js",
    "verify:gateway-signing": "node dist/src/verify-gateway-signing-acceptance.js",
    "acceptance:gateway-signing": "node scripts/gateway-signing-acceptance.mjs",
    "signer:gateway": "node dist/src/gateway-signer-server.js",
    "test:signer": "npm run build && node --test dist/test/gateway-signer.test.js",
    "test:investigation": "npm run build && node --test --test-concurrency=1 dist/test/gateway-investigation.test.js dist/test/gateway-investigation-run.test.js",
    "eval:batch-investigation": "npm run --silent build && node dist/src/evaluate-batch-investigation.js",
    "eval:batch-development": "npm run --silent build && node dist/src/evaluate-batch-investigation-dev.js",
    "eval:investigation-dialogue": "npm run --silent build && node dist/src/evaluate-investigation-dialogue-v2.js",
    "eval:investigation-dialogue-v1": "npm run --silent build && node dist/src/evaluate-investigation-dialogue.js",
    "eval:gateway-exceptions": "npm run --silent build && node dist/src/evaluate-gateway-exceptions.js",
    "test:exceptions": "npm run build && node --test dist/test/gateway-exception-benchmark.test.js",
    "eval:case-packets": "npm run --silent build && node dist/src/evaluate-case-packets.js",
    "eval:claim-assessment": "npm run --silent build && node dist/src/evaluate-claim-assessment.js",
    "review:claims": "npm run --silent build && node dist/src/claim-review-cli.js",
    "eval:frozen-claims": "npm run --silent build && node dist/src/frozen-claim-evaluation-cli.js",
    "verify:portfolio": "node scripts/verify-portfolio.mjs",
    "test:redis": "npm run build && node --test dist/test/redis-integration.js"
  },
  "dependencies": {
    "@circle-fin/x402-batching": "^4.0.0",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "redis": "^5.12.4",
    "viem": "^2.57.19"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^18.6.0-beta.19",
    "typescript": "^5.9.3"
  }
}
